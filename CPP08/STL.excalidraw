      "isDeleted": false,
      "boundElements": null,
      "updated": 1785694151826,
      "link": null,
      "locked": false,
      "text": "Stack container follows LIFO (Last In First Out) order of insertion and deletion. It means\nthat most recently inserted element is removed first and the first inserted element will\nbe removed last. This is done by inserting and deleting elements at only one end of the\nstack which is generally called the top of the stack.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stack container follows LIFO (Last In First Out) order of insertion and deletion. It means that most recently inserted element is removed first and the first inserted element will be removed last. This is done by inserting and deleting elements at only one end of the stack which is generally called the top of the stack.",
      "autoResize": false,
      "lineHeight": 1.25
    },
