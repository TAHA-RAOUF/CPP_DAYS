      "updated": 1785694089673,
      "link": null,
      "locked": false,
      "text": "std::stack normally hides its underlying\ncontainer and does not give you iterators. Your\njob is to create a class that behaves like a stack\nbut also allows iteration through its elements.",
      "fontSize": 34.57500837195421,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "std::stack normally hides its underlying container and does not give you iterators. Your job is to create a class that behaves like a stack but also allows iteration through its elements.",
      "autoResize": false,
      "lineHeight": 1.25
    },
