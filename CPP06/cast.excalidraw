    },
    {
      "id": "2GDeJwBqjaeJ2rgzEuNgU",
      "type": "text",
      "x": 2399.1224545697078,
      "y": 3773.810933173036,
      "width": 301.36620197169697,
      "height": 31.12261676096234,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 391719937,
      "version": 57,
      "versionNonce": 711778127,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "For example, downcasting:",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For example, downcasting:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XOri7i9Wytxd83Iv1PkaP",
      "type": "text",
      "x": 2444.698348829208,
      "y": 3860.9542601037306,
      "width": 210.21441345269585,
      "height": 31.12261676096234,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 119558287,
      "version": 57,
      "versionNonce": 55713135,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "Base* p = new B();",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Base* p = new B();",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "shXC-E_dDzvNpkjHsdeKn",
      "type": "text",
      "x": 2404.799235823327,
      "y": 3948.097587034425,
      "width": 290.01263946445846,
      "height": 31.12261676096234,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 909509601,
      "version": 57,
      "versionNonce": 623548303,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "B* b = static_cast<B*>(p);",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B* b = static_cast<B*>(p);",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k26yZUM2rvZymjpmVFNcd",
      "type": "text",
      "x": 2347.508774558154,
      "y": 4035.2409139651195,
      "width": 404.59356199480396,
      "height": 31.12261676096234,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2J",
      "roundness": null,
      "seed": 1929733807,
      "version": 57,
      "versionNonce": 103730607,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "You're basically telling the compiler:",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You're basically telling the compiler:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "StVyPt4BCSVVzYDamVLgh",
      "type": "text",
      "x": 2429.224192893612,
      "y": 4122.384240895814,
      "width": 241.16272532388854,
      "height": 31.12261676096234,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2K",
      "roundness": null,
      "seed": 929882049,
      "version": 57,
      "versionNonce": 1099382735,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "\"I know that p is a B.\"",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"I know that p is a B.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wSyunU_DdaOijFFRxy8Qg",
      "type": "text",
      "x": 2236.4508775374247,
      "y": 4209.527567826509,
      "width": 626.7093560362626,
      "height": 31.12261676096234,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2L",
      "roundness": null,
      "seed": 1780660431,
      "version": 57,
      "versionNonce": 2035052015,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "But if it isn't actually a B, you've created a bad situation.",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But if it isn't actually a B, you've created a bad situation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
