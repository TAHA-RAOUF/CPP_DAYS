    {
      "id": "259TXQbEaNOjfkYbcKpu2",
      "type": "text",
      "x": 1155.55029296875,
      "y": 1208.5,
      "width": 798.8994140625,
      "height": 92,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
