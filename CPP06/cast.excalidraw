      "isDeleted": false,
      "boundElements": null,
      "updated": 1785516118202,
      "link": null,
      "locked": false,
      "text": "The compiler trusts you.",
      "fontSize": 24.898093408769874,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The compiler trusts you.",
